<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Item 1: Bayangan offset tanpa blur (kanan-bawah 4dp) -->
    <item
        android:left="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="@color/neo_black" />
        </shape>
    </item>

    <!-- Item 2: Permukaan kartu -->
    <item
        android:bottom="4dp"
        android:right="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="@color/neo_white" />
            <stroke
                android:width="3dp"
                android:color="@color/neo_black" />
        </shape>
    </item>
</layer-list>
